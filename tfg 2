/* ===== Música chill (generada en el navegador) ===== */
let ac=null,master=null,nb=null,tm=null,nextT=0,step=0,mus=true;const beat=60/68,CH=[[48,52,55,59],[45,48,52,55],[41,45,48,52],[43,47,50,53]];
function tone(m,t,dur,g,type,a){const o=ac.createOscillator(),e=ac.createGain();o.type=type;o.frequency.value=440*Math.pow(2,(m-69)/12);e.gain.setValueAtTime(0.0001,t);e.gain.linearRampToValueAtTime(g,t+a);e.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(e);e.connect(master);o.start(t);o.stop(t+dur+.1)}
function kick(t){const o=ac.createOscillator(),e=ac.createGain();o.frequency.setValueAtTime(130,t);o.frequency.exponentialRampToValueAtTime(45,t+.12);e.gain.setValueAtTime(.2,t);e.gain.exponentialRampToValueAtTime(.001,t+.25);o.connect(e);e.connect(master);o.start(t);o.stop(t+.3)}
function hat(t){const s=ac.createBufferSource();s.buffer=nb;const h=ac.createBiquadFilter();h.type='highpass';h.frequency.value=7000;const e=ac.createGain();e.gain.setValueAtTime(.025,t);e.gain.exponentialRampToValueAtTime(.001,t+.05);s.connect(h);h.connect(e);e.connect(master);s.start(t)}
function sched(){while(nextT<ac.currentTime+.3){const s=step,i=s%8,ch=CH[Math.floor(s/8)%4],t=nextT;if(i===0){ch.forEach(m=>tone(m,t,beat*4+.5,.045,'triangle',.9));tone(ch[0]-12,t,beat*2,.16,'sine',.02)}if(i===5)tone(ch[0]-12,t,beat*1.5,.12,'sine',.02);if(Math.random()>.25)tone(ch[[0,2,1,3,2,1,3,2][i]]+12,t,.9,.05,'triangle',.01);if(i===0||i===4)kick(t);if(i%2)hat(t);nextT+=beat/2;step++}}
function musicOn(){if(!mus)return;try{if(!ac){ac=new(window.AudioContext||window.webkitAudioContext)();master=ac.createGain();const lp=ac.createBiquadFilter();lp.type='lowpass';lp.frequency.value=4500;const dl=ac.createDelay();dl.delayTime.value=beat*.75;const fb=ac.createGain();fb.gain.value=.35;master.connect(lp);lp.connect(ac.destination);lp.connect(dl);dl.connect(fb);fb.connect(dl);dl.connect(ac.destination);const n=Math.floor(ac.sampleRate*.05);nb=ac.createBuffer(1,n,ac.sampleRate);const d=nb.getChannelData(0);for(let i=0;i<n;i++)d[i]=Math.random()*2-1}ac.resume();clearInterval(tm);master.gain.cancelScheduledValues(ac.currentTime);master.gain.setTargetAtTime(.7,ac.currentTime,1.5);nextT=ac.currentTime+.15;step=0;tm=setInterval(sched,50)}catch(e){}}
function musicOff(){if(!ac)return;master.gain.setTargetAtTime(0,ac.currentTime,1.5);const x=tm;setTimeout(()=>{if(tm===x)clearInterval(tm)},6000)}
/* ================================================== */

async function play(){
  const t=++run;try{speechSynthesis.cancel()}catch(e){}
  $('start').style.display='none';$('end').style.display='none';$('sub').style.display='block';cur=-1;musicOn();
  document.querySelectorAll('.scene svg').forEach(v=>{if(v.dataset.step)v.dataset.step='0'});
  for(let i=0;i<C.length;i++){
    if(t!==run)return;
    const [s,st,ox,oy,txt]=C[i],v=document.querySelector('#s'+s+' svg');
    if(s!==cur){document.querySelectorAll('.scene').forEach((e,k)=>e.classList.toggle('on',k===s));cur=s}
    if(v.dataset.step!==undefined)v.dataset.step=st;
    cam(v,txt.length*70+2500,i,ox,oy);$('sub').textContent=txt;
    await speak(txt);
    await sleep(2500);
  }
  if(t===run){$('sub').style.display='none';$('end').style.display='flex';musicOff()}
}
$('mu').onclick=()=>{mus=!mus;$('mu').textContent=mus?'♪ Música: sí':'♪ Música: no'};$('go').onclick=play;$('re').onclick=play;
$('fs').onclick=()=>{const s=$('stage');(s.requestFullscreen||s.webkitRequestFullscreen||function(){}).call(s)};
</script>
