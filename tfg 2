      <div class="body-portrait">${wrap(av.body,'0 0 120 190')}</div>
      <div class="role-tag">${av.role}</div>
      <h3>${av.name}</h3>
      <p class="title">${av.title}</p>
      <p class="passive">${av.passive}</p>
