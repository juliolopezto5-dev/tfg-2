}

function updateBuffBanner(){
  const el = document.getElementById('buff-banner');
  if(state.buff && state.buff.remaining>0){ el.textContent = `⚡ ${state.buff.label} activa — ${state.buff.remaining} golpes reforzados restantes`; }
  else el.textContent = '\u00A0';
}

function pointOnPath(pathId, pct){ const path = document.getElementById(pathId); const len = path.getTotalLength(); return path.getPointAtLength(len*pct); }

function placeTeamMarkers(){
  const allyG = document.getElementById('ally-markers'); const enemyG = document.getElementById('enemy-markers');
  allyG.innerHTML=''; enemyG.innerHTML='';
  const allyList = state.mode==='mp' ? state.lobby.players.map(p=>byId(p.avatarId)) : [state.avatar, ...state.teammates];
  allyList.forEach(av=>{
    const key = laneKeyForRole(av.role); const p = pointOnPath(key, 0.08);
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('id','marker-'+av.id); g.style.animation='bob 2.4s ease-in-out infinite';
    const isMe = av.id===state.avatar.id;
    const s = isMe?24:18;
    g.innerHTML = `<circle cx="${p.x}" cy="${p.y}" r="${s/2+3}" fill="#0a0f1c" stroke="${av.accent}" stroke-width="2"/><svg x="${p.x-s/2}" y="${p.y-s/2}" width="${s}" height="${s}" viewBox="0 0 100 100">${av.icon}</svg>`;
    allyG.appendChild(g);
  });
  ROLE_ORDER.forEach(role=>{
    const key = laneKeyForRole(role); const p = pointOnPath(key, 0.92);
    const isMine = role===state.avatar.role;
    const s = isMine?24:18;
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('id','enemy-'+role); g.style.animation='bob 2.6s ease-in-out infinite';
    g.innerHTML = `<circle cx="${p.x}" cy="${p.y}" r="${s/2+3}" fill="#0a0f1c" stroke="#d15050" stroke-width="2"/><svg x="${p.x-s/2}" y="${p.y-s/2}" width="${s}" height="${s}" viewBox="0 0 100 100">${UMBRA_CREST}</svg>`;
    enemyG.appendChild(g);
  });
}
function movePlayerMarker(){
  const key = laneKeyForRole(state.avatar.role);
  const pct = Math.min(0.92, 0.08 + (state.laneStrength/100)*0.84);
  const p = pointOnPath(key, pct);
  const m = document.getElementById('marker-'+state.avatar.id);
  if(m){ const c=m.querySelector('circle'), s=m.querySelector('svg'); const sz=parseFloat(s.getAttribute('width'));
    c.setAttribute('cx',p.x); c.setAttribute('cy',p.y); s.setAttribute('x',p.x-sz/2); s.setAttribute('y',p.y-sz/2); }
  const enemyPct = Math.min(0.92, 0.08 + ((100-state.laneStrength)/100)*0.84);
  const ep = pointOnPath(key, enemyPct);
  const em = document.getElementById('enemy-'+state.avatar.role);
  if(em){ const c=em.querySelector('circle'), s=em.querySelector('svg'); const sz=parseFloat(s.getAttribute('width'));
    c.setAttribute('cx',ep.x); c.setAttribute('cy',ep.y); s.setAttribute('x',ep.x-sz/2); s.setAttribute('y',ep.y-sz/2); }
}

function buildProgressDots(){ const wrapEl=document.getElementById('progress-dots'); wrapEl.innerHTML=''; for(let i=0;i<20;i++){ const d=document.createElement('span'); d.id='dot-'+i; wrapEl.appendChild(d);} state.laneStrength=50; }
function refreshDots(){ for(let i=0;i<20;i++){ const d=document.getElementById('dot-'+i); d.className=''; if(state.results[i]==='hit')d.classList.add('hit'); else if(state.results[i]==='miss')d.classList.add('miss'); if(i===state.index)d.classList.add('now'); } }
function updateNexusBars(){
  document.getElementById('blue-hp-fill').style.width = Math.max(0,state.blueHP)+'%';
  document.getElementById('red-hp-fill').style.width = Math.max(0,state.redHP)+'%';
  document.getElementById('blue-hp-num').textContent = Math.max(0,Math.round(state.blueHP));
  document.getElementById('red-hp-num').textContent = Math.max(0,Math.round(state.redHP));
}

function loadQuestion(){
  const q = state.questions[state.index];
  document.getElementById('hud-qcount').textContent = `Pregunta ${state.index+1}/20`;
  document.getElementById('subject-label').textContent = q.subject.toUpperCase();
  document.getElementById('qtype-label').textContent = TYPE_LABEL[q.type];
  const card = document.getElementById('question-card'); card.classList.remove('shake','objective'); void card.offsetWidth;
  document.getElementById('qtext').innerHTML = q.type==='fill' ? q.text.replace('___','<span class="blank"></span>') : q.text;
  document.getElementById('feedback-line').textContent='\u00A0'; document.getElementById('feedback-line').className='feedback-line';
  refreshDots();
  renderAnswerArea(q, (ok, triggerEl, area)=> submitAnswerSolo(ok, triggerEl, area));
  state.qStart = performance.now();
}

function renderAnswerArea(q, onSubmit){
  const area = document.getElementById('answers-area'); area.innerHTML='';
  if(q.type==='bool'){
    const grid=document.createElement('div'); grid.className='bool-grid';
    ['Verdadero','Falso'].forEach(label=>{ const btn=document.createElement('button'); btn.className='opt-btn'; btn.textContent=label;
      btn.addEventListener('click', ()=> onSubmit(label==='Verdadero'? q.answer===true : q.answer===false, btn, area)); grid.appendChild(btn); });
    area.appendChild(grid);
  } else if(q.type==='match'){
    let opts = q.options.slice();
    const activeAv = getActiveAvatar();
    if(activeAv && activeAv.id==='aethelgard'){
      const correct=q.answer; const wrongs=shuffle(opts.filter(o=>o!==correct)); const keep=wrongs.slice(0,Math.max(1,Math.ceil(wrongs.length/2)));
      opts = shuffle([correct, ...keep]);
    } else opts = shuffle(opts);
    const grid=document.createElement('div'); grid.className='opt-grid';
    opts.forEach(label=>{ const btn=document.createElement('button'); btn.className='opt-btn'; btn.textContent=label;
      btn.addEventListener('click', ()=> onSubmit(label===q.answer, btn, area)); grid.appendChild(btn); });
    area.appendChild(grid);
  } else {
    const w=document.createElement('div'); w.className='text-answer';
    const input=document.createElement('input'); input.type='text'; input.placeholder = q.type==='fill'?'Completa el término...':'Escribe tu respuesta...'; input.autocomplete='off';
    const btn=document.createElement('button'); btn.textContent='Responder';
    const doSubmit=()=>{ const val=normalize(input.value||''); onSubmit(val.length>0 && val===normalize(q.answer), btn, area); };
    btn.addEventListener('click', doSubmit); input.addEventListener('keydown', e=>{ if(e.key==='Enter') doSubmit(); });
    w.appendChild(input); w.appendChild(btn); area.appendChild(w); setTimeout(()=>input.focus(),50);
  }
}
function getActiveAvatar(){ return state.avatar; }

function spawnParticles(good){
  const layer=document.getElementById('particle-layer'); layer.innerHTML='';
  const color = good?'var(--verdant)':'var(--danger)';
  for(let i=0;i<10;i++){ const p=document.createElement('div'); p.className='particle';
    const angle=(Math.PI*2*i)/10, dist=60+Math.random()*30;
    p.style.setProperty('--bx',(Math.cos(angle)*dist)+'px'); p.style.setProperty('--by',(Math.sin(angle)*dist)+'px'); p.style.background=color;
    layer.appendChild(p); }
  setTimeout(()=>{ layer.innerHTML=''; },750);
}
function showBuff(text){ const el=document.getElementById('buff-flag'); el.textContent=text; clearTimeout(showBuff._t); showBuff._t=setTimeout(()=>{ el.textContent='\u00A0'; },1700); }
function flashAnswerVisual(area, triggerEl, q){
  if(area.querySelector('.opt-btn')){
    area.querySelectorAll('.opt-btn').forEach(b=>{ const label=b.textContent; const correctLabel = q.type==='bool' ? (q.answer?'Verdadero':'Falso') : q.answer;
      if(label===correctLabel) b.classList.add('correct'); else if(b===triggerEl) b.classList.add('wrong'); });
  }
}

/* ---- SOLO: enviar respuesta ---- */
function submitAnswerSolo(isCorrect, triggerEl, area){
  area.querySelectorAll('button, input').forEach(el=>el.disabled=true);
  const responseTimeSec = (performance.now()-state.qStart)/1000;
  const q = state.questions[state.index];
  const fb=document.getElementById('feedback-line'), card=document.getElementById('question-card'), flash=document.getElementById('flash-overlay');
  flashAnswerVisual(area, triggerEl, q);
  state.answeredCount++; state.results[state.index]=isCorrect?'hit':'miss'; spawnParticles(isCorrect);

  if(isCorrect){
    const r = coreApplyCorrect(state, state.avatar, responseTimeSec, q.type);
    state.correctCount++; state.redHP=Math.max(0,state.redHP-r.dmg); state.blueHP=Math.min(100,state.blueHP+r.heal);
    state.laneStrength=Math.min(100,state.laneStrength+8);
    state.freezeRemaining += (state.avatar.id==='vespera'&&responseTimeSec<2) ? 5 : 3;
    fb.textContent='\u2713 Correcto — tu línea avanza y el núcleo rival se resquebraja.'; fb.className='feedback-line good'; flash.className='flash-overlay good';
    if(r.msg) showBuff('\u2726 '+r.msg.replace('\u2726 ',''));
  } else {
    const r = coreApplyWrong(state, state.avatar);
    state.blueHP=Math.max(0,state.blueHP-r.dmg); state.laneStrength=Math.max(0,state.laneStrength-6);
    state.rateMultiplier *= wrongClockFactor(state.avatar);
    fb.textContent=`\u2717 Incorrecto — la respuesta era "${q.type==='bool'?(q.answer?'Verdadero':'Falso'):q.answer}".`; fb.className='feedback-line bad'; flash.className='flash-overlay bad';
    card.classList.add('shake');
    if(r.msg) showBuff(r.msg);
  }
  updateNexusBars(); updateBuffBanner(); movePlayerMarker(); refreshDots();

  if(state.blueHP<=0){ setTimeout(()=>endGameSolo(false,'nexus'),700); return; }
  if(state.redHP<=0){ setTimeout(()=>endGameSolo(true,'nexus'),700); return; }

  setTimeout(()=>{
    state.index++;
    if(OBJECTIVE_AT.includes(state.answeredCount) && !state.objectivesTriggered.includes(state.answeredCount)){
      state.objectivesTriggered.push(state.answeredCount); triggerObjectiveSolo(); return;
    }
    proceedOrEndSolo();
  }, 900);
}
function proceedOrEndSolo(){
  if(state.index>=20 || state.timeLeft<=0){ endGameSolo(state.redHP>state.blueHP,'timeup'); } else { loadQuestion(); }
}

function triggerObjectiveSolo(){
  state.running=false;
  const overlay=document.getElementById('gather-overlay'), ring=document.getElementById('gather-ring'), title=document.getElementById('gather-title'), sub=document.getElementById('gather-sub');
  ring.querySelectorAll('.ally-dot').forEach(d=>d.remove());
  const isGuardian = Math.random()<0.5;
  title.textContent = isGuardian ? '¡El Guardián de Cristal ha despertado en el río!' : '¡El Coloso del Vacío emerge junto al río!';
  sub.textContent='Vuestro equipo debe reunirse antes de reclamarlo…';
  overlay.classList.add('active');
  const allTeam=[state.avatar, ...state.teammates];
  allTeam.forEach((av,i)=>{
    const dot=document.createElement('div'); dot.className='ally-dot'; dot.innerHTML=wrap_(av.icon);
    const angle=Math.random()*Math.PI*2, dist=95;
    dot.style.left=(110+Math.cos(angle)*dist)+'px'; dot.style.top=(110+Math.sin(angle)*dist)+'px'; ring.appendChild(dot);
    setTimeout(()=>{ const ta=(Math.PI*2*i)/allTeam.length; dot.style.left=(110+Math.cos(ta)*34-13)+'px'; dot.style.top=(110+Math.sin(ta)*34-13)+'px'; },120);
  });
  setTimeout(()=>{ sub.textContent='¡Los cinco aliados están reunidos! Responde para asegurar el objetivo.'; },1300);
  setTimeout(()=>{ overlay.classList.remove('active'); state.running=true; state.lastTick=performance.now(); requestAnimationFrame(soloTick); loadObjectiveQuestionSolo(isGuardian); },2200);
}
function loadObjectiveQuestionSolo(isGuardian){
  const used = state.questions.slice(0,state.index);
  const pool = BANK.filter(q=>!used.includes(q));
  const q = pool.length ? shuffle(pool)[0] : shuffle(BANK)[0];
  state.questions[state.index]=q;
  document.getElementById('hud-qcount').textContent=`Objetivo de equipo · Pregunta ${state.index+1}/20`;
  document.getElementById('subject-label').textContent=(isGuardian?'GUARDIÁN DE CRISTAL · ':'COLOSO DEL VACÍO · ')+q.subject.toUpperCase();
  document.getElementById('qtype-label').textContent=TYPE_LABEL[q.type];
  const card=document.getElementById('question-card'); card.classList.add('objective');
  document.getElementById('qtext').innerHTML = q.type==='fill' ? q.text.replace('___','<span class="blank"></span>') : q.text;
  document.getElementById('feedback-line').textContent='\u00A0'; refreshDots();
  renderAnswerArea(q, (isCorrectResolved, triggerEl, area)=>{
    area.querySelectorAll('button,input').forEach(el=>el.disabled=true);
    state.answeredCount++; state.results[state.index]=isCorrectResolved?'hit':'miss'; spawnParticles(isCorrectResolved);
    const fb=document.getElementById('feedback-line'), flash=document.getElementById('flash-overlay');
    if(isCorrectResolved){
      state.correctCount++; state.redHP=Math.max(0,state.redHP-22);
      state.buff = {remaining:5, mult:1.5, label:(isGuardian?'Bendición del Guardián':'Poder del Coloso')};
      fb.textContent=(isGuardian?'¡Guardián de Cristal asegurado! ':'¡Coloso del Vacío derrotado! ')+'Vuestro equipo obtiene una bendición: golpes reforzados.';
      fb.className='feedback-line good'; flash.className='flash-overlay good';
    } else {
      state.blueHP=Math.max(0,state.blueHP-15);
      fb.textContent='La Academia Umbra reclama el objetivo. Vuestro núcleo sufre el contragolpe.'; fb.className='feedback-line bad'; flash.className='flash-overlay bad';
      card.classList.add('shake');
    }
    updateNexusBars(); updateBuffBanner(); refreshDots();
    if(state.blueHP<=0){ setTimeout(()=>endGameSolo(false,'nexus'),700); return; }
    if(state.redHP<=0){ setTimeout(()=>endGameSolo(true,'nexus'),700); return; }
    setTimeout(()=>{ state.index++; proceedOrEndSolo(); },1000);
  });
  state.qStart=performance.now();
}

function soloTick(now){
  if(!state.running) return;
  const dt=(now-state.lastTick)/1000; state.lastTick=now;
  if(state.freezeRemaining>0){ state.freezeRemaining=Math.max(0,state.freezeRemaining-dt); } else { state.timeLeft -= dt*state.rateMultiplier; }
  if(state.timeLeft<=0){ state.timeLeft=0; renderClock(); endGameSolo(state.redHP>state.blueHP,'timeup'); return; }
  renderClock(); requestAnimationFrame(soloTick);
}
function renderClock(){
  const pct=Math.max(0,state.timeLeft/state.baseTime); const r=25, circumference=2*Math.PI*r;
  const ring=document.getElementById('timer-ring'); ring.setAttribute('stroke-dasharray',circumference); ring.setAttribute('stroke-dashoffset',circumference*(1-pct));
  let color='#c9a15c'; if(pct<0.5) color='#d9a13b'; if(pct<0.25) color='#c24444'; ring.style.stroke=color;
  document.getElementById('timer-num').textContent=Math.ceil(state.timeLeft);
  document.getElementById('timer-mini').style.animation = pct<0.25 ? 'pulseCritical 1s ease-in-out infinite' : 'none';
}
function endGameSolo(won, reason){
  state.running=false;
  finishScreen(won, reason, state.avatar, state.correctCount, state.answeredCount, state.blueHP, state.redHP);
}

/* =========================================================
   MODO MULTIJUGADOR — sincronizado por sondeo
   ========================================================= */
function enterMultiplayerGame(){
  state.avatar = byId(state.lobby.players.find(p=>p.id===state.myId).avatarId);
  state.teammates = state.lobby.players.filter(p=>p.id!==state.myId).map(p=>byId(p.avatarId));
  state.hasClock = false; state.buff = state.lobby.match.buff; state.blueHP=state.lobby.match.blueHP; state.redHP=state.lobby.match.redHP;
  state.correctCount=state.lobby.match.correctCount; state.answeredCount=state.lobby.match.answeredCount; state.results=[];
  setupGameScreenCommon();
  startLobbyPolling();
  renderTurnStrip();
  refreshMultiplayerTurn();
}
function renderTurnStrip(){
  const strip=document.getElementById('turn-strip'); strip.innerHTML='';
  state.lobby.players.forEach(p=>{
    const av=byId(p.avatarId);
    const chip=document.createElement('div'); chip.className='turn-chip'; chip.id='chip-'+p.id;
    chip.innerHTML = `<span class="tc-portrait">${wrap_(av.icon)}</span><span>${p.name}</span>`;
    strip.appendChild(chip);
  });
}
function updateTurnHighlight(){
  const match = state.lobby.match;
  const activeId = match.turnOrder[match.turnIndex % match.turnOrder.length];
  state.lobby.players.forEach(p=>{ const chip=document.getElementById('chip-'+p.id); if(chip) chip.classList.toggle('active', p.id===activeId); });
  return activeId;
}
function applyRemoteMatchState(match){
  if(!match) return;
  state.blueHP=match.blueHP; state.redHP=match.redHP; state.correctCount=match.correctCount; state.answeredCount=match.answeredCount;
  state.buff = match.buff; updateNexusBars(); updateBuffBanner();
  const activeId = updateTurnHighlight();
  if(match.finished){
    endGameMultiplayer(match); return;
  }
  if(activeId===state.myId && !state.myTurnActive){ state.myTurnActive=true; beginMyTurn(); }
  if(activeId!==state.myId && state.myTurnActive){ state.myTurnActive=false; }
  if(activeId!==state.myId){ renderSpectatorView(match); }
}
function refreshMultiplayerTurn(){ applyRemoteMatchState(state.lobby.match); }

let turnCountdownHandle=null;
function beginMyTurn(){
  const match = state.lobby.match;
  const q = BANK[match.questionOrder[match.qIndex]];
  document.getElementById('hud-portrait').innerHTML = wrap(state.avatar.icon,'0 0 100 100');
  document.getElementById('hud-name').textContent = state.avatar.name+' · '+state.avatar.role;
  document.getElementById('hud-qcount').textContent = `Tu turno · Pregunta ${match.qIndex+1}/20`;
  document.getElementById('subject-label').textContent = q.subject.toUpperCase();
  document.getElementById('qtype-label').textContent = TYPE_LABEL[q.type];
  const isObjective = OBJECTIVE_AT.includes(match.answeredCount+1) && !match.objectivesTriggered.includes(match.answeredCount+1);
  const card=document.getElementById('question-card'); card.classList.remove('shake','objective'); void card.offsetWidth;
  if(isObjective) card.classList.add('objective');
  document.getElementById('qtext').innerHTML = q.type==='fill' ? q.text.replace('___','<span class="blank"></span>') : q.text;
  document.getElementById('feedback-line').textContent='\u00A0';

  let timeLeftTurn = 20;
  document.getElementById('timer-num').textContent = timeLeftTurn;
  renderClockStatic(timeLeftTurn/20);
  clearInterval(turnCountdownHandle);
  turnCountdownHandle = setInterval(()=>{
    timeLeftTurn--; document.getElementById('timer-num').textContent = Math.max(0,timeLeftTurn); renderClockStatic(Math.max(0,timeLeftTurn)/20);
    if(timeLeftTurn<=0){ clearInterval(turnCountdownHandle); if(state.myTurnActive) submitAnswerMultiplayer(false, null, document.getElementById('answers-area'), q, isObjective); }
  }, 1000);

  renderAnswerArea(q, (ok, triggerEl, area)=>{ clearInterval(turnCountdownHandle); submitAnswerMultiplayer(ok, triggerEl, area, q, isObjective); });
  state.qStart = performance.now();
}
function renderClockStatic(pct){
  const r=25, circumference=2*Math.PI*r; const ring=document.getElementById('timer-ring');
  ring.setAttribute('stroke-dasharray',circumference); ring.setAttribute('stroke-dashoffset',circumference*(1-pct));
  let color='#c9a15c'; if(pct<0.5) color='#d9a13b'; if(pct<0.25) color='#c24444'; ring.style.stroke=color;
  document.getElementById('timer-mini').style.animation = pct<0.25 ? 'pulseCritical 1s ease-in-out infinite' : 'none';
}
function renderSpectatorView(match){
  const q = BANK[match.questionOrder[match.qIndex]];
  const activeId = match.turnOrder[match.turnIndex % match.turnOrder.length];
  const activePlayer = state.lobby.players.find(p=>p.id===activeId);
  document.getElementById('hud-qcount').textContent = `Pregunta ${match.qIndex+1}/20`;
  document.getElementById('subject-label').textContent = q.subject.toUpperCase();
  document.getElementById('qtype-label').textContent = TYPE_LABEL[q.type];
  document.getElementById('qtext').textContent = q.type==='fill' ? q.text.replace('___','______') : q.text;
  document.getElementById('answers-area').innerHTML = `<div class="waiting-note">Esperando a que <strong>${activePlayer?activePlayer.name:'un aliado'}</strong> responda…</div>`;
  document.getElementById('feedback-line').textContent = match.log || '\u00A0';
  renderClockStatic(1);
}

async function submitAnswerMultiplayer(isCorrect, triggerEl, area, q, isObjective){
  if(area) area.querySelectorAll('button, input').forEach(el=>el.disabled=true);
  const responseTimeSec = (performance.now()-state.qStart)/1000;
  const fb=document.getElementById('feedback-line'), card=document.getElementById('question-card'), flash=document.getElementById('flash-overlay');
  if(area) flashAnswerVisual(area, triggerEl, q);
  spawnParticles(isCorrect);

  const match = state.lobby.match;
  match.answeredCount++;

  if(isCorrect){
    const r = coreApplyCorrect(match, state.avatar, responseTimeSec, q.type);
    const bonusDmg = isObjective ? 14 : 0;
    match.correctCount++; match.redHP = Math.max(0, match.redHP-r.dmg-bonusDmg); match.blueHP = Math.min(100, match.blueHP+r.heal);
    match.log = `${state.avatar.name} acertó "${q.subject}" y dañó el núcleo rival.`;
    if(isObjective){ match.buff = {remaining:5, mult:1.5, label:'Bendición del objetivo'}; match.objectivesTriggered.push(match.answeredCount); match.log = `¡${state.avatar.name} aseguró el objetivo de equipo!`; }
    fb.textContent='\u2713 Correcto — el núcleo rival se resquebraja.'; fb.className='feedback-line good'; flash.className='flash-overlay good';
  } else {
    const r = coreApplyWrong(match, state.avatar);
    const bonusDmg = isObjective ? 8 : 0;
    match.blueHP = Math.max(0, match.blueHP-r.dmg-bonusDmg);
    match.log = `${state.avatar.name} falló "${q.subject}". Vuestro núcleo sufre daño.`;
    fb.textContent=`\u2717 Incorrecto — la respuesta era "${q.type==='bool'?(q.answer?'Verdadero':'Falso'):q.answer}".`; fb.className='feedback-line bad'; flash.className='flash-overlay bad';
    if(card) card.classList.add('shake');
  }

  match.qIndex++;
  match.turnIndex = (match.turnIndex+1) % match.turnOrder.length;

  if(match.blueHP<=0){ match.finished=true; match.winner='red'; }
  else if(match.redHP<=0){ match.finished=true; match.winner='blue'; }
  else if(match.qIndex>=20){ match.finished=true; match.winner = match.redHP>match.blueHP ? 'blue' : 'red'; }

  state.myTurnActive=false;
  await setLobby(state.lobbyCode, state.lobby);
  updateNexusBars(); updateBuffBanner();

  setTimeout(()=>{ applyRemoteMatchState(state.lobby.match); }, 900);
}

function endGameMultiplayer(match){
  clearInterval(turnCountdownHandle); clearInterval(lobbyPollHandle);
  const won = match.winner==='blue';
  finishScreen(won, 'nexus', state.avatar, match.correctCount, match.answeredCount, match.blueHP, match.redHP);
}

/* =========================================================
   FINAL (compartido)
   ========================================================= */
function finishScreen(won, reason, avatar, correctCount, answeredCount, blueHP, redHP){
  const card=document.getElementById('end-card'); card.className='end-card '+(won?'win':'lose');
  document.getElementById('end-title').textContent = won ? '¡Núcleo Umbra destruido!' : (reason==='nexus' ? '¡Vuestro núcleo ha caído!' : 'El reloj cósmico colapsa');
  document.getElementById('end-sub').textContent = won
    ? `El Equipo Chronos, con ${avatar.name} en la línea, abre una grieta en la Academia Umbra.`
    : `${avatar.name} y su equipo no lograron sostener la línea a tiempo.`;
  document.getElementById('stat-correct').textContent = correctCount+'/'+answeredCount;
  document.getElementById('stat-blue').textContent = Math.max(0,Math.round(blueHP));
  document.getElementById('stat-red').textContent = Math.max(0,Math.round(redHP));
  showScreen('screen-end');
}
document.getElementById('retry-btn').addEventListener('click', ()=>{
  clearInterval(lobbyPollHandle); clearInterval(turnCountdownHandle);
  state = {}; showScreen('screen-home');
});
</script>
