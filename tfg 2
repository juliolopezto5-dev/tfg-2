<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Academia de Chronos — Grieta del Reloj</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Spectral:wght@400;500;600;700&display=swap');

:root{
  --void:#080a12; --void-2:#111729; --void-3:#1a2138;
  --brass:#c9a15c; --brass-dim:#8a7245;
  --parchment:#ece4d2; --parchment-dim:#a29a88;
  --verdant:#5f8f6a; --danger:#c24444;
  --blue-team:#4d8fd1; --red-team:#d15050;
  --ring-track:#232b45;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  min-height:100vh;
  background:radial-gradient(circle at 50% -10%, #151d33 0%, transparent 55%),
             radial-gradient(circle at 85% 90%, #121a2c 0%, transparent 45%), var(--void);
  color:var(--parchment); font-family:'Spectral',serif;
  display:flex; align-items:flex-start; justify-content:center; padding:24px; position:relative;
}
.stage{ position:relative; z-index:1; width:100%; max-width:940px; }
.screen{ display:none; }
.screen.active{ display:block; animation:fadeUp .45s ease; }
@keyframes fadeUp{ from{opacity:0; transform:translateY(12px);} to{opacity:1; transform:translateY(0);} }
@keyframes shakeCard{ 0%,100%{transform:translateX(0);} 20%{transform:translateX(-8px);} 40%{transform:translateX(7px);} 60%{transform:translateX(-5px);} 80%{transform:translateX(4px);} }
@keyframes popIn{ 0%{transform:scale(.85); opacity:0;} 100%{transform:scale(1); opacity:1;} }
@keyframes pulseCritical{ 0%,100%{filter:drop-shadow(0 0 0px var(--danger));} 50%{filter:drop-shadow(0 0 10px var(--danger));} }
@keyframes burstOut{ 0%{transform:translate(-50%,-50%) scale(.2); opacity:1;} 100%{transform:translate(var(--bx),var(--by)) scale(1); opacity:0;} }
@keyframes flashGood{ 0%{background:rgba(95,143,106,0.28);} 100%{background:rgba(95,143,106,0);} }
@keyframes flashBad{ 0%{background:rgba(194,68,68,0.28);} 100%{background:rgba(194,68,68,0);} }
@keyframes glowGold{ 0%,100%{box-shadow:0 0 0px rgba(201,161,92,0.4);} 50%{box-shadow:0 0 22px rgba(201,161,92,0.55);} }
@keyframes shimmer{ 0%{transform:translateX(-40px);} 100%{transform:translateX(400px);} }
@keyframes pulseOpac{ 0%,100%{opacity:0.55;} 50%{opacity:1;} }
@keyframes bob{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(-4px);} }
@keyframes spinSlow{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }

.eyebrow-title{ text-align:center; margin-bottom:26px; }
.eyebrow-title h1{
  font-family:'Cinzel',serif; font-weight:700; font-size:clamp(26px,5vw,38px); letter-spacing:0.02em; margin:0 0 8px 0;
  background:linear-gradient(180deg,var(--brass) 0%, #8a7245 100%); -webkit-background-clip:text; background-clip:text; color:transparent;
}
.eyebrow-title p{ color:var(--parchment-dim); font-size:14px; margin:0; line-height:1.6; }

.mode-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; max-width:560px; margin:0 auto; }
.mode-card{
  background:linear-gradient(180deg,var(--void-2),var(--void-3)); border:1px solid #2a3252; border-radius:14px;
  padding:26px 18px; text-align:center; cursor:pointer; transition:transform .2s ease, border-color .2s ease;
}
.mode-card:hover{ transform:translateY(-4px); border-color:var(--brass); }
.mode-card .micon{ font-size:30px; margin-bottom:10px; }
.mode-card h3{ font-family:'Cinzel',serif; font-size:16px; margin:0 0 6px 0; color:var(--brass); }
.mode-card p{ font-size:12.5px; color:var(--parchment-dim); margin:0; line-height:1.5; }

.avatar-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px; }
.avatar-card{
  background:linear-gradient(180deg, var(--void-2), var(--void-3)); border:1px solid #2a3252; border-radius:12px;
  padding:14px; cursor:pointer; transition:border-color .2s ease, transform .2s ease; text-align:center;
}
.avatar-card:hover{ transform:translateY(-4px); border-color:var(--card-accent, var(--brass)); }
.avatar-card.disabled{ opacity:0.35; cursor:not-allowed; pointer-events:none; }
.body-portrait{ width:100px; height:150px; margin:0 auto 8px auto; }
.body-portrait svg{ width:100%; height:100%; display:block; filter:drop-shadow(0 6px 8px rgba(0,0,0,0.4)); }
.role-tag{
  display:inline-block; font-family:'Cinzel',serif; font-size:10px; letter-spacing:0.06em; padding:3px 9px; border-radius:20px; margin-bottom:6px;
  background:rgba(201,161,92,0.12); color:var(--card-accent,var(--brass)); border:1px solid var(--card-accent,var(--brass));
}
.avatar-card h3{ font-family:'Cinzel',serif; font-size:15px; margin:0 0 2px 0; }
.avatar-card .title{ font-size:11px; color:var(--parchment-dim); margin:0 0 8px 0; }
.avatar-card p.passive{ font-size:11.5px; line-height:1.45; color:var(--parchment-dim); margin:0; text-align:left; }

.lineup-wrap{ display:flex; gap:18px; align-items:stretch; margin-bottom:20px; flex-wrap:wrap; justify-content:center;}
.team-col{ flex:1; min-width:230px; background:linear-gradient(180deg,var(--void-2),var(--void-3)); border-radius:12px; padding:16px; border:1px solid #2a3252; }
.team-col h4{ font-family:'Cinzel',serif; font-size:13px; letter-spacing:0.05em; margin:0 0 12px 0; text-align:center; }
.team-col.blue h4{ color:var(--blue-team); } .team-col.red h4{ color:var(--red-team); }
.roster-row{ display:flex; align-items:center; gap:10px; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.05); }
.roster-row:last-child{ border-bottom:none; }
.roster-row .mini-portrait{ width:32px; height:32px; border-radius:50%; overflow:hidden; flex-shrink:0; border:1.5px solid var(--brass-dim); }
.roster-row .mini-portrait svg{ width:100%; height:100%; }
.roster-row .rinfo{ font-size:12.5px; }
.roster-row .rinfo .rname{ font-weight:600; color:var(--parchment); }
.roster-row .rinfo .rrole{ color:var(--parchment-dim); font-size:11px; }
.roster-row.you{ background:rgba(201,161,92,0.08); border-radius:6px; padding:7px 6px; }
.vs-mark{ align-self:center; font-family:'Cinzel',serif; font-size:22px; color:var(--brass); padding:0 4px; }
.enemy-sigil{ width:32px; height:32px; border-radius:50%; background:radial-gradient(circle at 35% 30%, #5a2a2a, #2a1414); border:1.5px solid var(--red-team); flex-shrink:0; }
.begin-btn{
  display:block; margin:6px auto 0 auto; font-family:'Cinzel',serif; font-size:14px; letter-spacing:0.04em; padding:14px 34px; border-radius:8px;
  border:1px solid var(--brass); background:var(--brass); color:var(--void); cursor:pointer; font-weight:700;
}
.begin-btn:hover{ background:#dab26f; }
.begin-btn:disabled{ opacity:0.4; cursor:not-allowed; }
.secondary-btn{
  display:inline-block; font-family:'Cinzel',serif; font-size:13px; letter-spacing:0.03em; padding:10px 20px; border-radius:8px;
  border:1px solid var(--brass-dim); background:transparent; color:var(--brass); cursor:pointer;
}
.secondary-btn:hover{ border-color:var(--brass); }

/* mp menu / lobby */
.mp-box{ max-width:420px; margin:0 auto; background:linear-gradient(180deg,var(--void-2),var(--void-3)); border:1px solid #2a3252; border-radius:12px; padding:22px; text-align:center; }
.mp-box input{ width:100%; font-family:'Cinzel',serif; letter-spacing:0.15em; text-align:center; font-size:20px; padding:12px; border-radius:8px; border:1px solid #2a3252; background:var(--void-3); color:var(--parchment); margin:12px 0; text-transform:uppercase; }
.code-display{ font-family:'Cinzel',serif; font-size:32px; letter-spacing:0.2em; color:var(--brass); margin:14px 0; }
.lobby-players{ margin:16px 0; text-align:left; }
.lobby-player-row{ display:flex; align-items:center; gap:10px; padding:8px 10px; background:var(--void-3); border-radius:8px; margin-bottom:6px; }
.lobby-player-row .mini-portrait{ width:30px;height:30px;border-radius:50%; overflow:hidden; border:1.5px solid var(--brass-dim); }
.lobby-player-row .mini-portrait svg{ width:100%;height:100%; }
.lobby-player-row span.pname{ font-size:13px; font-weight:600; }
.lobby-player-row span.prole{ font-size:11px; color:var(--parchment-dim); margin-left:auto; }
.lobby-status{ font-size:12.5px; color:var(--parchment-dim); margin:10px 0; }

.match-header{ display:flex; align-items:center; gap:14px; margin-bottom:12px; }
.nexus-bar-wrap{ flex:1; }
.nexus-bar-wrap .lbl{ font-family:'Cinzel',serif; font-size:10.5px; letter-spacing:0.05em; margin-bottom:4px; display:flex; justify-content:space-between; }
.nexus-track{ height:9px; border-radius:6px; background:var(--ring-track); overflow:hidden; }
.nexus-fill{ height:100%; border-radius:6px; transition:width .5s ease; }
.nexus-fill.blue{ background:linear-gradient(90deg,#3a6fa8,var(--blue-team)); }
.nexus-fill.red{ background:linear-gradient(90deg,var(--red-team),#a83a3a); }
.timer-mini{ display:flex; flex-direction:column; align-items:center; width:60px; flex-shrink:0; }
.timer-mini svg{ width:52px; height:52px; }
.timer-mini .tnum{ font-family:'Cinzel',serif; font-size:14px; margin-top:-40px; }

.buff-banner{ text-align:center; font-size:11.5px; color:var(--brass); min-height:16px; margin-bottom:8px; letter-spacing:0.02em; }

.turn-strip{ display:flex; gap:6px; justify-content:center; margin-bottom:10px; flex-wrap:wrap; }
.turn-chip{ display:flex; align-items:center; gap:5px; font-size:11px; padding:4px 9px 4px 4px; border-radius:20px; background:var(--void-3); border:1px solid #2a3252; color:var(--parchment-dim); }
.turn-chip .tc-portrait{ width:20px;height:20px;border-radius:50%; overflow:hidden; }
.turn-chip .tc-portrait svg{ width:100%;height:100%; }
.turn-chip.active{ border-color:var(--brass); color:var(--brass); animation:pulseOpac 1.4s ease-in-out infinite; }

.map-wrap{ position:relative; background:linear-gradient(180deg,#0d1424,#0a0f1c); border:1px solid #232c48; border-radius:12px; padding:8px; margin-bottom:14px; overflow:hidden; }
.map-wrap svg{ width:100%; height:auto; display:block; }
.lane-role-label{ text-align:center; font-family:'Cinzel',serif; font-size:11px; letter-spacing:0.06em; color:var(--brass); margin-bottom:2px; }

.hud-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.hud-avatar{ display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--parchment-dim); }
.hud-avatar .hportrait{ width:26px; height:26px; border-radius:50%; overflow:hidden; border:1px solid var(--brass); }
.hud-avatar .hportrait svg{ width:100%;height:100%; }
.hud-qcount{ font-family:'Cinzel',serif; font-size:12px; color:var(--brass); }

.subject-label{ text-align:center; font-family:'Cinzel',serif; font-size:11px; letter-spacing:0.08em; color:var(--brass-dim); margin-bottom:4px; }
.qtype-label{ text-align:center; font-size:11px; color:var(--parchment-dim); margin-bottom:10px; }

.question-card{
  background:linear-gradient(180deg, var(--void-2), var(--void-3)); border:1px solid #2a3252; border-radius:12px; padding:22px 20px;
  text-align:center; min-height:60px; position:relative; overflow:hidden; animation:popIn .35s ease;
}
.question-card.objective{ border-color:var(--brass); animation:glowGold 1.4s ease-in-out infinite, popIn .35s ease; }
.question-card.shake{ animation:shakeCard .4s ease; }
.question-card p.qtext{ font-size:18px; line-height:1.5; margin:0; color:var(--parchment); }
.question-card .blank{ display:inline-block; border-bottom:2px solid var(--brass); min-width:70px; margin:0 3px; }
.flash-overlay{ position:absolute; inset:0; pointer-events:none; border-radius:12px; }
.flash-overlay.good{ animation:flashGood .7s ease; } .flash-overlay.bad{ animation:flashBad .7s ease; }

.waiting-note{ text-align:center; font-size:13.5px; color:var(--parchment-dim); padding:20px; }

.answers{ margin-top:16px; }
.opt-grid, .bool-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.opt-btn{
  font-family:'Spectral',serif; font-size:15px; padding:14px 12px; border-radius:8px; border:1px solid #2a3252;
  background:var(--void-3); color:var(--parchment); cursor:pointer; transition:border-color .15s ease, transform .1s ease;
}
.opt-btn:hover:not(:disabled){ border-color:var(--brass); transform:translateY(-1px); }
.opt-btn.correct{ border-color:var(--verdant); background:#1b3324; animation:popIn .25s ease; }
.opt-btn.wrong{ border-color:var(--danger); background:#3a1d1d; }
.opt-btn:disabled{ cursor:default; opacity:0.85; }

.text-answer{ display:flex; gap:8px; margin-top:2px; }
.text-answer input{ flex:1; font-family:'Spectral',serif; font-size:16px; padding:12px 14px; border-radius:8px; border:1px solid #2a3252; background:var(--void-3); color:var(--parchment); }
.text-answer input:focus{ outline:none; border-color:var(--brass); }
.text-answer button{ font-family:'Cinzel',serif; font-size:13px; letter-spacing:0.03em; padding:0 20px; border-radius:8px; border:1px solid var(--brass); background:var(--brass); color:var(--void); cursor:pointer; font-weight:600; }
.text-answer button:hover{ background:#dab26f; }

.feedback-line{ margin-top:12px; min-height:20px; font-size:13.5px; text-align:center; }
.feedback-line.good{ color:var(--verdant); } .feedback-line.bad{ color:var(--danger); }
.buff-flag{ text-align:center; font-size:12px; min-height:16px; color:var(--brass); margin-top:6px; }

.progress-dots{ display:flex; flex-wrap:wrap; gap:6px; justify-content:center; margin-top:16px; }
.progress-dots span{ width:8px;height:8px;border-radius:50%; background:var(--ring-track); }
.progress-dots span.hit{ background:var(--verdant); } .progress-dots span.miss{ background:var(--danger); }
.progress-dots span.now{ outline:2px solid var(--brass); outline-offset:2px; }

.particle-layer{ position:absolute; inset:0; pointer-events:none; overflow:visible; }
.particle{ position:absolute; top:50%; left:50%; width:6px; height:6px; border-radius:50%; background:var(--verdant); animation:burstOut .7s ease-out forwards; }

.gather-overlay{ position:fixed; inset:0; background:rgba(4,6,12,0.86); display:none; align-items:center; justify-content:center; z-index:50; }
.gather-overlay.active{ display:flex; }
.gather-box{ text-align:center; }
.gather-box h3{ font-family:'Cinzel',serif; color:var(--brass); font-size:20px; margin:0 0 20px 0; letter-spacing:0.03em; }
.gather-ring{ position:relative; width:220px; height:220px; margin:0 auto; }
.gather-center{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:46px; height:46px; border-radius:50%; background:radial-gradient(circle,var(--brass),#7a611f); box-shadow:0 0 18px rgba(201,161,92,0.6); animation:spinSlow 6s linear infinite; }
.ally-dot{ position:absolute; width:26px; height:26px; border-radius:50%; border:2px solid var(--brass-dim); transition:top 1.1s ease, left 1.1s ease; overflow:hidden; }
.ally-dot svg{ width:100%; height:100%; }
.gather-sub{ margin-top:16px; font-size:13px; color:var(--parchment-dim); }

.end-card{ text-align:center; padding:10px 6px; }
.end-card h2{ font-family:'Cinzel',serif; font-size:28px; margin:0 0 10px 0; }
.end-card.win h2{ color:var(--verdant); } .end-card.lose h2{ color:var(--danger); }
.end-card p.sub{ color:var(--parchment-dim); font-size:14.5px; margin:0 0 22px 0; }
.stat-row{ display:flex; justify-content:center; gap:26px; margin-bottom:26px; flex-wrap:wrap; }
.stat{ min-width:100px; } .stat .num{ font-family:'Cinzel',serif; font-size:24px; color:var(--brass); }
.stat .lbl{ font-size:11px; color:var(--parchment-dim); letter-spacing:0.03em; }
.retry-btn{ font-family:'Cinzel',serif; font-size:14px; letter-spacing:0.03em; padding:14px 30px; border-radius:8px; border:1px solid var(--brass); background:transparent; color:var(--brass); cursor:pointer; font-weight:600; }
.retry-btn:hover{ background:var(--brass); color:var(--void); }

@media (max-width:560px){
  .opt-grid, .bool-grid{ grid-template-columns:1fr; }
  .lineup-wrap{ flex-direction:column; } .vs-mark{ display:none; }
  .mode-grid{ grid-template-columns:1fr; }
}
</style>
</head>
<body>

<div class="stage">

  <!-- HOME -->
  <div class="screen active" id="screen-home">
    <div class="eyebrow-title">
      <h1>Academia de Chronos</h1>
      <p>La Grieta del Reloj espera. Cinco líneas, diez campeones, un núcleo que proteger.</p>
    </div>
    <div class="mode-grid">
      <div class="mode-card" id="mode-solo"><div class="micon">🧙</div><h3>Individual</h3><p>Juega solo con cuatro aliados arcanos controlados por la Academia.</p></div>
      <div class="mode-card" id="mode-mp"><div class="micon">🔗</div><h3>Multijugador</h3><p>Crea una sala o únete con un código para jugar por turnos con más gente.</p></div>
    </div>
  </div>

  <!-- MP MENU -->
  <div class="screen" id="screen-mp-menu">
    <div class="eyebrow-title"><h1 style="font-size:26px;">Sala multijugador</h1><p>Crea una sala nueva o únete a una existente con su código.</p></div>
    <div class="mp-box">
      <button class="begin-btn" id="mp-create-btn">Crear partida</button>
      <p style="margin:16px 0 6px 0; color:var(--parchment-dim); font-size:12px;">— o —</p>
      <input type="text" id="mp-join-input" placeholder="CÓDIGO DE SALA" maxlength="5">
      <button class="secondary-btn" id="mp-join-btn">Unirse con código</button>
      <p id="mp-menu-error" style="color:var(--danger); font-size:12px; min-height:16px; margin-top:10px;">&nbsp;</p>
    </div>
  </div>

  <!-- AVATAR SELECT -->
  <div class="screen" id="screen-avatars">
    <div class="eyebrow-title">
      <h1 id="avatar-title">Elige tu campeón</h1>
      <p>Diez campeones, cinco roles. Cada uno altera el ritmo de la partida a su manera.</p>
    </div>
    <div class="avatar-grid" id="avatar-grid"></div>
  </div>

  <!-- LOBBY (mp) -->
  <div class="screen" id="screen-lobby">
    <div class="eyebrow-title"><h1 style="font-size:26px;">Sala de espera</h1><p>Comparte este código para que se unan más jugadores.</p></div>
    <div class="mp-box">
      <div class="code-display" id="lobby-code-display">-----</div>
      <div class="lobby-players" id="lobby-players"></div>
      <div class="lobby-status" id="lobby-status">Esperando jugadores…</div>
      <button class="begin-btn" id="lobby-start-btn">Iniciar partida</button>
    </div>
  </div>

  <!-- LINEUP (solo) -->
  <div class="screen" id="screen-lineup">
    <div class="eyebrow-title"><h1 style="font-size:26px;">Formación de equipos</h1><p>Equipo Chronos contra la Academia Umbra. Cinco contra cinco, línea contra línea.</p></div>
    <div class="lineup-wrap">
      <div class="team-col blue"><h4>EQUIPO CHRONOS</h4><div id="blue-roster"></div></div>
      <div class="vs-mark">VS</div>
      <div class="team-col red"><h4>ACADEMIA UMBRA</h4><div id="red-roster"></div></div>
    </div>
    <button class="begin-btn" id="begin-btn">Entrar a la Grieta</button>
  </div>

  <!-- GAME -->
  <div class="screen" id="screen-game">
    <div class="match-header">
      <div class="nexus-bar-wrap">
        <div class="lbl"><span style="color:var(--blue-team)">NÚCLEO CHRONOS</span><span id="blue-hp-num">100</span></div>
        <div class="nexus-track"><div class="nexus-fill blue" id="blue-hp-fill" style="width:100%"></div></div>
      </div>
      <div class="timer-mini" id="timer-mini">
        <svg viewBox="0 0 60 60">
          <circle cx="30" cy="30" r="25" fill="none" stroke="#232b45" stroke-width="6"></circle>
          <circle cx="30" cy="30" r="25" fill="none" stroke="#c9a15c" stroke-width="6" stroke-linecap="round" id="timer-ring" transform="rotate(-90 30 30)"></circle>
        </svg>
        <div class="tnum" id="timer-num">100</div>
      </div>
      <div class="nexus-bar-wrap">
        <div class="lbl"><span id="red-hp-num">100</span><span style="color:var(--red-team)">NÚCLEO UMBRA</span></div>
        <div class="nexus-track"><div class="nexus-fill red" id="red-hp-fill" style="width:100%"></div></div>
      </div>
    </div>

    <div class="buff-banner" id="buff-banner">&nbsp;</div>
    <div class="turn-strip" id="turn-strip" style="display:none;"></div>

    <div class="map-wrap"><svg id="map-svg" viewBox="0 0 400 400"></svg></div>
    <div class="lane-role-label" id="lane-role-label">LÍNEA MEDIA</div>

    <div class="hud-row">
      <div class="hud-avatar"><span class="hportrait" id="hud-portrait"></span><span id="hud-name"></span></div>
      <div class="hud-qcount" id="hud-qcount">Pregunta 1/20</div>
    </div>

    <div class="subject-label" id="subject-label">MATEMÁTICAS</div>
    <div class="qtype-label" id="qtype-label">Deducción directa</div>

    <div class="question-card" id="question-card">
      <div class="flash-overlay" id="flash-overlay"></div>
      <div class="particle-layer" id="particle-layer"></div>
      <p class="qtext" id="qtext">Cargando pregunta...</p>
    </div>

    <div class="answers" id="answers-area"></div>
