function myClientId(){ if(!state.myId) state.myId = 'p_'+Math.random().toString(36).slice(2,10); return state.myId; }

async function getLobby(code){
  try{ const res = await window.storage.get('lobby:'+code, true); return res ? JSON.parse(res.value) : null; }
  catch(e){ return null; }
}
async function setLobby(code, obj){
  obj.updatedAt = Date.now();
  try{ await window.storage.set('lobby:'+code, JSON.stringify(obj), true); return true; }
  catch(e){ return false; }
}

document.getElementById('mp-create-btn').addEventListener('click', async ()=>{
  const code = randCode();
  state = { mode:'mp', role:'host', lobbyCode:code };
  myClientId();
  document.getElementById('avatar-title').textContent = 'Elige tu campeón (anfitrión)';
  buildAvatarGrid([], (av)=> createLobbyAndGo(code, av));
  showScreen('screen-avatars');
});

document.getElementById('mp-join-btn').addEventListener('click', async ()=>{
  const codeInput = document.getElementById('mp-join-input').value.trim().toUpperCase();
  const errEl = document.getElementById('mp-menu-error');
  errEl.textContent = '\u00A0';
  if(codeInput.length<4){ errEl.textContent='Introduce un código válido.'; return; }
  const lobby = await getLobby(codeInput);
  if(!lobby){ errEl.textContent='No se encontró ninguna sala con ese código.'; return; }
  if(lobby.started){ errEl.textContent='Esa partida ya ha comenzado.'; return; }
  if(lobby.players.length>=5){ errEl.textContent='La sala ya tiene 5 jugadores.'; return; }
  state = { mode:'mp', role:'guest', lobbyCode:codeInput };
  myClientId();
  const takenIds = lobby.players.map(p=>p.avatarId);
  document.getElementById('avatar-title').textContent = 'Elige tu campeón';
  buildAvatarGrid(takenIds, (av)=> joinLobbyAndGo(codeInput, av));
  showScreen('screen-avatars');
});

async function createLobbyAndGo(code, av){
  const lobby = {
    code, hostId: state.myId, started:false,
    players:[{ id: state.myId, name:'Anfitrión', avatarId: av.id }]
  };
  await setLobby(code, lobby);
  state.lobby = lobby; state.avatar = av;
  enterLobbyScreen();
}
async function joinLobbyAndGo(code, av){
  const lobby = await getLobby(code);
  if(!lobby || lobby.started || lobby.players.some(p=>p.avatarId===av.id)){
    document.getElementById('avatar-title').textContent = 'Ese campeón ya no está disponible, elige otro';
    const takenIds = lobby ? lobby.players.map(p=>p.avatarId) : [];
    buildAvatarGrid(takenIds, (av2)=> joinLobbyAndGo(code, av2));
    return;
  }
  lobby.players.push({ id: state.myId, name:'Aliado '+lobby.players.length, avatarId: av.id });
  await setLobby(code, lobby);
  state.lobby = lobby; state.avatar = av;
  enterLobbyScreen();
}

function enterLobbyScreen(){
  document.getElementById('lobby-code-display').textContent = state.lobbyCode;
  renderLobbyPlayers();
  document.getElementById('lobby-start-btn').style.display = (state.role==='host') ? 'block' : 'none';
  showScreen('screen-lobby');
  startLobbyPolling();
}
function renderLobbyPlayers(){
  const wrap = document.getElementById('lobby-players');
  wrap.innerHTML = '';
  state.lobby.players.forEach(p=>{
    const av = byId(p.avatarId);
    const row = document.createElement('div');
    row.className = 'lobby-player-row';
    row.innerHTML = `<span class="mini-portrait">${wrap_(av.icon)}</span><span class="pname">${p.name}${p.id===state.myId?' (tú)':''}</span><span class="prole">${av.role} · ${av.name}</span>`;
    wrap.appendChild(row);
  });
  document.getElementById('lobby-status').textContent = state.lobby.players.length<2
    ? 'Esperando a que se unan más jugadores… (mínimo recomendado: 2)'
    : `${state.lobby.players.length} jugadores conectados.`;
}
function wrap_(inner){ return wrap(inner,'0 0 100 100'); }

let lobbyPollHandle=null;
function startLobbyPolling(){
  clearInterval(lobbyPollHandle);
  lobbyPollHandle = setInterval(async ()=>{
    const fresh = await getLobby(state.lobbyCode);
    if(!fresh) return;
    state.lobby = fresh;
    if(document.getElementById('screen-lobby').classList.contains('active')) renderLobbyPlayers();
    if(fresh.started && !state.mpGameStarted){
      state.mpGameStarted = true;
      clearInterval(lobbyPollHandle);
      enterMultiplayerGame();
    }
    if(state.mpGameStarted && document.getElementById('screen-game').classList.contains('active')){
      applyRemoteMatchState(fresh.match);
    }
  }, 1500);
}

document.getElementById('lobby-start-btn').addEventListener('click', async ()=>{
  const lobby = await getLobby(state.lobbyCode) || state.lobby;
  const questionOrder = shuffle(BANK.map((_,i)=>i)).slice(0,20);
  lobby.started = true;
  lobby.match = {
    questionOrder, qIndex:0, blueHP:100, redHP:100, correctCount:0, answeredCount:0,
    objectivesTriggered:[], buff:{remaining:0, mult:1, label:''}, turnOrder: lobby.players.map(p=>p.id),
    turnIndex:0, consecutiveMiss:0, consecutiveCorrect:0, finished:false, winner:null, log:'La partida ha comenzado.'
  };
  await setLobby(state.lobbyCode, lobby);
  state.lobby = lobby; state.mpGameStarted = true;
  clearInterval(lobbyPollHandle);
  enterMultiplayerGame();
});

