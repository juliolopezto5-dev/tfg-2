/* =========================================================
   MOTOR DE PARTIDA — compartido
   ========================================================= */
const BASE_CORRECT_DMG = 10, BASE_WRONG_DMG = 8;

function coreApplyCorrect(ctx, av, responseTimeSec, qType){
  let dmg = BASE_CORRECT_DMG, heal = 0, msg = null;
  ctx.consecutiveCorrect = (ctx.consecutiveCorrect||0)+1;
  ctx.consecutiveMiss = 0;

  if(av.id==='ignis' && ctx.consecutiveCorrect%3===0){
    if(ctx.hasClock){ ctx.timeLeft = Math.min(ctx.baseTime, ctx.timeLeft+7); msg='\u2726 Combustión Mental: +7s incinerados.'; }
    else { dmg += 6; msg='\u2726 Combustión Mental: golpe incinerado extra.'; }
  }
  if(av.id==='sylva' && (qType==='fill'||qType==='direct') && ctx.blueHP<45){
    if(ctx.hasClock){ ctx.timeLeft = Math.min(ctx.baseTime, ctx.timeLeft+6); msg='\u2726 Fotosíntesis: +6s regenerados.'; }
    else { heal += 6; msg='\u2726 Fotosíntesis: tu núcleo se regenera.'; }
  }
  if(av.id==='vespera' && responseTimeSec<2){ dmg = Math.round(dmg*1.6); msg='\u2726 Pacto Umbrío: golpe potenciado.'; }
  if(av.id==='nyxira' && ctx.lastWasMiss){ dmg *= 2; msg='\u2726 Emboscada: ¡daño doblado!'; }
  if(av.id==='zephyrion' && qType==='match'){ dmg += 4; msg = msg || '\u2726 Corriente Ascendente: daño reforzado.'; }
  if(av.id==='kaelith'){ ctx.kaelithStreak = (ctx.kaelithStreak||0)+1; if(ctx.kaelithStreak>=3){ dmg = Math.round(dmg*1.8); ctx.kaelithStreak=0; msg='\u2726 Tiro Certero: ¡golpe crítico!'; } }
  if(av.id==='mossgrave'){ heal += 3; }

  if(ctx.buff && ctx.buff.remaining>0){ dmg = Math.round(dmg*ctx.buff.mult); ctx.buff.remaining--; if(ctx.buff.remaining===0) ctx.buff.label=''; }

  ctx.lastWasMiss = false;
  return { dmg, heal, msg };
}
function coreApplyWrong(ctx, av){
  let dmg = BASE_WRONG_DMG, msg = null;
  ctx.consecutiveCorrect = 0; ctx.kaelithStreak = 0;
  if(av.id==='khorvath'){ if(ctx.hasClock){ /* manejado aparte en el reloj */ } else { dmg = Math.round(dmg*0.55); } msg='Distorsión Temporal amortigua el golpe.'; }
  if(av.id==='ferrovox'){ dmg = Math.round(dmg*0.65); msg = msg || 'Blindaje Templado absorbe parte del daño.'; }
  if(av.id==='vespera' && ctx.blueHP<45){ dmg = Math.round(dmg*2); msg='\u2716 Pacto Umbrío: castigo duplicado en el abismo.'; }
  ctx.lastWasMiss = true;
  return { dmg, msg };
}
function wrongClockFactor(av){ return av.id==='khorvath' ? 1.08 : 1.22; }

