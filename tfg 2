function goToLineup(playerAvatar){
  state.avatar = playerAvatar;
  state.teammates = AVATARS.filter(a=>a.id!==playerAvatar.id && a.role!==playerAvatar.role)
    .filter((a,i,arr)=> arr.findIndex(x=>x.role===a.role)===i); // un compañero por rol restante
  // asegurar exactamente 4 compañeros de roles distintos al del jugador
  const neededRoles = ROLE_ORDER.filter(r=>r!==playerAvatar.role);
  state.teammates = neededRoles.map(role=> shuffle(AVATARS.filter(a=>a.role===role))[0]);

  const blueWrap = document.getElementById('blue-roster'); blueWrap.innerHTML='';
  const orderedTeam = [playerAvatar, ...state.teammates].sort((a,b)=> ROLE_ORDER.indexOf(a.role)-ROLE_ORDER.indexOf(b.role));
  orderedTeam.forEach(av=>{
    const row = document.createElement('div'); row.className = 'roster-row' + (av.id===playerAvatar.id ? ' you' : '');
    row.innerHTML = `<span class="mini-portrait">${wrap_(av.icon)}</span><div class="rinfo"><div class="rname">${av.name}${av.id===playerAvatar.id?' (tú)':''}</div><div class="rrole">${av.role}</div></div>`;
    blueWrap.appendChild(row);
  });
  const redWrap = document.getElementById('red-roster'); redWrap.innerHTML='';
  ROLE_ORDER.forEach(role=>{
    const row = document.createElement('div'); row.className='roster-row';
    row.innerHTML = `<span class="enemy-sigil"></span><div class="rinfo"><div class="rname">Rival de Umbra</div><div class="rrole">${role}</div></div>`;
    redWrap.appendChild(row);
  });
  showScreen('screen-lineup');
}
