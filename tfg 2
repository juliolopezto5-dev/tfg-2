function startSoloGame(avatar){
  state = { ...state, avatar,
    questions: shuffle(BANK).slice(0,20), index:0, correctCount:0, answeredCount:0,
    timeLeft:100, baseTime:100, hasClock:true, rateMultiplier:1, freezeRemaining:0,
    consecutiveCorrect:0, consecutiveMiss:0, lastWasMiss:false, kaelithStreak:0,
    qStart:0, lastTick:performance.now(), running:true, results:[], blueHP:100, redHP:100,
    objectivesTriggered:[], buff:{remaining:0, mult:1, label:''}
  };
  setupGameScreenCommon();
  loadQuestion();
  requestAnimationFrame(soloTick);
}

function setupGameScreenCommon(){
  document.getElementById('hud-portrait').innerHTML = wrap(state.avatar.icon,'0 0 100 100');
  document.getElementById('hud-name').textContent = state.avatar.name + ' · ' + state.avatar.role;
  document.getElementById('lane-role-label').textContent =
    state.avatar.role==='TOP' ? 'LÍNEA SUPERIOR' : state.avatar.role==='MEDIA' ? 'LÍNEA MEDIA' :
    state.avatar.role==='JUNGLA' ? 'JUNGLA — RONDANDO EL RÍO' : 'LÍNEA INFERIOR';
  document.getElementById('map-svg').innerHTML = buildMapSVG();
